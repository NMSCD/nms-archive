[[FX]]

sampler gaPerParticleData = sampler_state
{
	TexUnit = 0;
};

sampler gDiffuseMap = sampler_state
{
	TexUnit = 1;
};

sampler gAlphaMap = sampler_state
{
    Address = Clamp;
    Filter = Trilinear;
    MaxAnisotropy = 0;
    TexUnit = 2;
    DefaultTexture = COMMON/WHITE.DDS;
};

sampler gFogFroxel = sampler_state
{
    Address = Clamp;
    TexUnit = 3;
};

// Uniforms

float4 gMultiTextureVec4    = {1.0, 0.0, 0.0, 0.0};
float4 gUVScrollStepVec4    = {0.0, 0.0, 0.0, 0.0};

// Contexts

context GPUPARTICLES_RENDER
{
    VertexShader = compile GLSL VS_GPUPARTICLES_RENDER;
    PixelShader  = compile GLSL PS_GPUPARTICLES_RENDER;
}

context GPUPARTICLES_RENDER_TRNSLCNT_ADDITIVE
{
    VertexShader = compile GLSL VS_GPUPARTICLES_RENDER;
    PixelShader  = compile GLSL PS_GPUPARTICLES_RENDER_ADDITIVE_SOFT;
}

context GPUPARTICLES_RENDER_TRANSLUCENT_SOFT
{
    VertexShader = compile GLSL VS_GPUPARTICLES_RENDER;
    PixelShader  = compile GLSL PS_GPUPARTICLES_RENDER_TRANSLUCENT_SFOT;
}

[[VS_GPUPARTICLES_RENDER]]
// =================================================================================================
#define D_PARTICLES_INDIRECT
#include "ParticleVertex.shader.h"

[[PS_GPUPARTICLES_RENDER]]
// =================================================================================================
#define D_PARTICLES_INDIRECT
#include "ParticleFragment.shader.h"

[[PS_GPUPARTICLES_RENDER_ADDITIVE_SOFT]]
// =================================================================================================
#define D_PARTICLES_INDIRECT
#define D_SOFT_PARTICLES
#define D_ADDITIVE_PARTICLES
#include "ParticleFragment.shader.h"

[[PS_GPUPARTICLES_RENDER_TRANSLUCENT_SFOT]]
// =================================================================================================
#define D_PARTICLES_INDIRECT
#define D_SOFT_PARTICLES
#include "ParticleFragment.shader.h"
