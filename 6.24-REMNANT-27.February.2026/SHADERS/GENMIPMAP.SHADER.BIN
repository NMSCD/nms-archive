[[FX]]

// Samplers
sampler gBufferMap = sampler_state
{
    Address = Clamp;
    TexUnit = 0;
};

// Uniforms
float4 gTextureSizeMipLevelVec4 = { 0.0, 0.0, 0.0, 0.0 };

// Contexts

context GENMIPMAP
{
    VertexShader = compile GLSL VS_FSQUAD;
    PixelShader  = compile GLSL FS_GENMIPMAP;
}

context COMPRESSBC1
{
    VertexShader  = compile GLSL VS_FSQUAD;
    PixelShader   = compile GLSL FS_COMPRESSBC1;
    ComputeShader = compile GLSL CS_COMPRESSBC1;
}

context COMPRESSBC3
{
    VertexShader  = compile GLSL VS_FSQUAD;
    PixelShader   = compile GLSL FS_COMPRESSBC3;
    ComputeShader = compile GLSL CS_COMPRESSBC3;
}

context COMPRESSBC5
{
    VertexShader  = compile GLSL VS_FSQUAD;
    PixelShader   = compile GLSL FS_COMPRESSBC5;
    ComputeShader = compile GLSL CS_COMPRESSBC5;
}

context COMPRESSBC7
{
    VertexShader  = compile GLSL VS_FSQUAD;
    PixelShader   = compile GLSL FS_COMPRESSBC7;
    ComputeShader = compile GLSL CS_COMPRESSBC7;
}

context [ PC ] COMPRESSBC7_NEW
{
    VertexShader  = compile GLSL VS_FSQUAD;
    PixelShader   = compile GLSL FS_COMPRESSBC7_NEW;
}

context COMPRESSBC7_TER
{
    VertexShader  = compile GLSL VS_FSQUAD;
    PixelShader   = compile GLSL FS_COMPRESSBC7_TERR;
    ComputeShader = compile GLSL CS_COMPRESSBC7_TERR;
}


[[VS_FSQUAD]]
// =================================================================================================
#define D_TEX_QUAD_NOTEXCOORD
#include "ImmediateModeVertex.shader.h"

[[FS_GENMIPMAP]]
// =================================================================================================
#define D_GENMIPMAP
#include "Fullscreen/MipDownsampleFragment.shader.h"
 
[[FS_COMPRESSBC3]]
// =================================================================================================
#include "Fullscreen/CompressFragment.shader.h"

[[FS_COMPRESSBC1]]
// =================================================================================================
#define D_DXT1
#include "Fullscreen/CompressFragment.shader.h"
 
[[FS_COMPRESSBC5]]
// =================================================================================================
#define D_BC5
#include "Fullscreen/CompressFragment.shader.h"

[[FS_COMPRESSBC7]]
// =================================================================================================
#define D_BC7
#include "Fullscreen/CompressFragment.shader.h"

[[FS_COMPRESSBC7_NEW]]
// =================================================================================================
#include "Compress/BC7.shader.h"

[[FS_COMPRESSBC7_TERR]]
// =================================================================================================
#define D_BC7
#define D_HEIGHTFIELD_MODE
#include "Fullscreen/CompressFragment.shader.h"

[[CS_COMPRESSBC1]]
// =================================================================================================
#define D_COMPUTECOMPRESS
#define D_DXT1
#include "Fullscreen/CompressFragment.shader.h"

[[CS_COMPRESSBC3]]
// =================================================================================================
#define D_COMPUTECOMPRESS
#include "Fullscreen/CompressFragment.shader.h"

[[CS_COMPRESSBC5]]
// =================================================================================================
#define D_BC5
#define D_COMPUTECOMPRESS
#include "Fullscreen/CompressFragment.shader.h"

[[CS_COMPRESSBC7]]
// =================================================================================================
#define D_BC7
#define D_COMPUTECOMPRESS
#include "Fullscreen/CompressFragment.shader.h"

[[CS_COMPRESSBC7_TERR]]
// =================================================================================================
#define D_BC7
#define D_COMPUTECOMPRESS
#define D_HEIGHTFIELD_MODE
#include "Fullscreen/CompressFragment.shader.h"
