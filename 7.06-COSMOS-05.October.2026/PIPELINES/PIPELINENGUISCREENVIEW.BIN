<!-- High Dynamic Range (HDR) utf-8Shading Pipeline -->
<Pipeline>
  <Setup>
    <ScaleInfo resScalingDefault="true" />
    
    <RenderTarget id="SHADOWBUF"      depthFormat="DEPTH16" depthBuf="true"  numColBufs="0"  format="RGBA8" scale="1.0" width="120" height="40" shadow="true" hasMips="false" numUniformBuffers="3" />

    <RenderTarget id="HDRBUF"         platforms="PROSPERO"                            depthBuf="true"  depthBufUsesBB="true" stencilBuf="true"  numColBufs="1"  format="RGBA16F" scale="1.0" width="3840" height="2160" postDlss="true"  />
    <RenderTarget id="HDRBUF"         platforms="PC|SCARLETT|ORBIS|XBOX|MACOS|OUNCE"  depthBuf="true"  depthBufUsesBB="true" stencilBuf="true"  numColBufs="1"  format="RGBA16F" scale="1.0" esramPageColBuf0="134"     postDlss="true"  />
    <RenderTarget id="HDRBUF"         platforms="HHELD|IOS" depthFormat="DEPTH24"     depthBuf="true"  depthBufUsesBB="true" stencilBuf="true"  numColBufs="1"  format="RGBA8"   scale="1.0" colBufUsesST="true"        postDlss="true"  />

    <RenderTarget id="CLOUDSHADOWS"      depthBuf="false" numColBufs="1" format="RGBA8"  scale="1.0" width="32" height="32" />
    <RenderTarget id="LIGHTS_BINS_DUMMY" depthBuf="false" numColBufs="1" format="RED8UI" scale="1.0" width="4"  height="4"  />

    <!--Bloom Targets (quarter-res entry; no half-res / final dedicated buffer)-->
    <RenderTarget id="BLOOM_BLURBUF_4A"  platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="R11FG11FB10F"   scale="0.25"     allowDcc="false" />
    <RenderTarget id="BLOOM_BLURBUF_4B"  platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="R11FG11FB10F"   scale="0.25"     allowDcc="false" />
    <RenderTarget id="BLOOM_BLURBUF_8A"  platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="R11FG11FB10F"   scale="0.125"    allowDcc="false" />
    <RenderTarget id="BLOOM_BLURBUF_8B"  platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="R11FG11FB10F"   scale="0.125"    allowDcc="false" />
    <RenderTarget id="BLOOM_BLURBUF_16"  platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="R11FG11FB10F"   scale="0.0625"   allowDcc="false" />
    <RenderTarget id="BLOOM_BLURBUF_32"  platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="R11FG11FB10F"   scale="0.03125"  allowDcc="false" />
    <RenderTarget id="BLOOM_BLURBUF_64"  platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="R11FG11FB10F"   scale="0.015625" allowDcc="false" />
    <RenderTarget id="BLOOM_THRESHOLD"   platforms="PC|SCARLETT|PROSPERO|MACOS|ORBIS|XBOX|OUNCE" depthBuf="false"        numColBufs="1" format="RGBA8"          scale="1.0"      width="4"  height="4"  />

  </Setup>

  <!-- Scene rendering -->
  <CommandQueue>

    <Stage id="Shadow">
      <BeginTarget target="SHADOWBUF" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" DepthAction="DontCare/DontCare" StencilAction="DontCare/DontCare"/>
      
      <ColourMask channels="RGBA"/>
      <ClearTarget depthBuf="true" colBuf0="false" excludeX360="false" col_R="0.0" col_G="0.0" col_B="0.0" col_A="0.0" />

      <EndTarget flushCB="false" flushDB="true" />
    </Stage>

    <Stage id="RenderClouds">
      <BeginTarget target="CLOUDSHADOWS" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/1" DepthAction="DontCare/DontCare" StencilAction="DontCare/DontCare"/>
      <ColourMask channels="RGBA"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <ClearTarget depthBuf="false" colBuf0="true" excludeX360="false" col_R="0.0" col_G="0.0" col_B="0.0" col_A="1.0" />
      <EndTarget flushCB="true" flushDB="false" />
      <UnbindBuffers />
    </Stage>    
    
    <Stage id="RenderRgbBackgroundFromTexture">
        <BeginTarget target="HDRBUF" />
        <RenderPass ColorAction0="DontCare/Store"DepthAction="DontCare/DontCare" StencilAction="DontCare/DontCare"/>

        <ColourMask channels="RGB"/>

        <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="Blend_PostMultAlpha" depthTest="always" alphaToCoverage="false"/>
        <DrawQuad material="Materials/BackgroundFromTexture.material.mbin" context="COPY" width="1.0" height="1.0" />
        <UnbindBuffers />
      
        <EndTarget flushCB="false" flushDB="false" />
    </Stage>

      
    <Stage id="RenderRgbBackgroundFromTextureWithClear">
        <BeginTarget target="HDRBUF" />
        <RenderPass ColorAction0="Clear/Store" ClearColor="1/0/0/1" DepthAction="Clear/DontCare" StencilAction="Clear/DontCare" ClearDepthStencil="0/0"/>
        
        <ColourMask channels="RGBA"/>
        <ClearTarget depthBuf="true" colBuf0="false" excludeX360="true" col_R="1.0" col_G="0.0" col_B="0.0" col_A="1.0" />
        <ColourMask channels="RGBA"/>

        <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
        
        <DrawQuad material="Materials/BackgroundFromTexture.material.mbin" context="COPYRGB_SETA" width="1.0" height="1.0" />
        <UnbindBuffers />

        <EndTarget flushCB="false" flushDB="false" />

    </Stage>

      
    <Stage id="RenderRgbaBackgroundFromTextureWithClear">
        <BeginTarget target="HDRBUF" />
        <RenderPass ColorAction0="Clear/Store" ClearColor="1/0/0/0" DepthAction="Clear/DontCare" StencilAction="Clear/DontCare" ClearDepthStencil="0/0"/>

        <ClearTarget depthBuf="true" colBuf0="false" excludeX360="true" col_R="1.0" col_G="0.0" col_B="0.0" col_A="0.0" />
        <ColourMask channels="RGBA"/>

        <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>

        <DrawQuad material="Materials/BackgroundFromTexture.material.mbin" context="COPY" width="1.0" height="1.0" />
        <UnbindBuffers />
  
        <EndTarget flushCB="false" flushDB="false" />

    </Stage>

      
    <Stage id="ClearToTransparentOnly">
        <BeginTarget target="HDRBUF" />
        <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" DepthAction="Clear/Store" StencilAction="Clear/Store" ClearDepthStencil="0/0"/>
        <ColourMask channels="RGBA"/>
        <ClearTarget depthBuf="true" colBuf0="true" excludeX360="true" col_R="0.0" col_G="0.0" col_B="0.0" col_A="0.0" />
        <ColourMask channels="RGBA"/>

        <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>

        <EndTarget flushCB="false" flushDB="false" />
    </Stage>

    <Stage id="Lighting"> 
      <BeginTarget target="HDRBUF" />
      <ColourMask channels="RGBA"/>

      <BindBuffer sampler="gShadowMap"       sourceRT="SHADOWBUF"       bufIndex="32" />
      <BindBuffer sampler="gCloudShadowMap"  sourceRT="CLOUDSHADOWS"    bufIndex="0" addressMode="wrap" />
      <BindBuffer sampler="gLightBins"       sourceRT="LIGHTS_BINS_DUMMY" bufIndex="0" />

       <!--Opaques-->
      <SetContext zwrite="true" colourWrite="true" cullMode="none" blendMode="replace" depthTest="less" alphaToCoverage="false"/>

      <!--Gun-->
      <SetContext zwrite="true" colourWrite="true" cullMode="back" blendMode="replace" depthTest="less"  />
      <DoForwardLightLoop type="Mesh"         class="GunOpaque"    context="LIT_FRWD_NS_NP"             order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="GunGlow"      context="LIT_FRWD_NS_NP"             order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="GunDecal"     context="LIT_FRWD_NS_NP"             order="STATECHANGES"  />

      <!-- solar system map planets -->
      <SetContext zwrite="true" colourWrite="true" cullMode="back" blendMode="replace" depthTest="lessEqual" />    
      <DoForwardLightLoop type="Mesh"         class="Atmosphere"              context="PLANET_NS_NP"   order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="AtmosphereGasGiant"      context="PLANET_GG_NS_NP"   order="STATECHANGES" />

        <!--alpha test with alpha to coverage-->
      <SetContext zwrite="true" colourWrite="true" cullMode="none" blendMode="replace" depthTest="less" alphaToCoverage="true"/>
      <DoForwardLightLoop type="Mesh"         class="Opaque"          context="LIT_FRWD_NS_NP"          order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="OpaqueBeforeUI"  context="LIT_FRWD_NS_NP"          order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="PLANET"          context="LIT_FORWARD_MESH"        order="STATECHANGES" />      
      <DoForwardLightLoop type="Mesh"         class="Cutout"          context="LIT_FRWD_NS_NP"          order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="Highlight"       context="LIT_FRWD_NS_NP"          order="STATECHANGES"/>
      <DoForwardLightLoop type="Mesh"         class="HighlightOccluded"       context="LIT_FRWD_NS_NP"          order="STATECHANGES"/>
      <DoForwardLightLoop type="Mesh"         class="HighlightAdditive"       context="LIT_FRWD_NS_NP"          order="STATECHANGES"/>
        
      <SetContext zwrite="true" colourWrite="true" cullMode="none" blendMode="replace" depthTest="less" alphaToCoverage="true"/>
      <DoForwardLightLoop type="Mesh"         class="DoubleSided"    context="LIT_FRWD_NS_NP"           order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="HighlightDoubleSided"    context="LIT_FRWD_NS_NP"           order="STATECHANGES" />        
      <SetContext zwrite="true" colourWrite="true" cullMode="back" blendMode="replace" depthTest="less" alphaToCoverage="true"/>

       <!--Glow-->
      <!--<ColourMask channels="RGBA"/>--> <!--NOTE: writing out alpha with a glow semantic messes up the GUI transparency :-(-->
      <SetContext zwrite="true" colourWrite="true" cullMode="none" blendMode="replace" depthTest="less" alphaToCoverage="false"/>
      <DoForwardLightLoop type="Mesh"         class="Glow"     context="LIT_FRWD_NS_NP"             order="STATECHANGES" />
      
       <!--SKY-->
      <ColourMask channels="RGB"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="Blend_PostMultAlpha" depthTest="less" alphaToCoverage="false"/>
      <DoForwardLightLoop type="Mesh" class="Sky" context="LIGHTING" order="BACK_TO_FRONT" />

      <UnbindBuffers />
      <EndTarget flushCB="false" flushDB="true" />
      
    </Stage>

    <Stage id="BlendedAbove">
      <BeginTarget target="HDRBUF" readOnlyDepth="true" />
      <RenderPass ColorAction0="Load/Store"DepthAction="Load/DontCare" StencilAction="Load/DontCare" ClearDepthStencil="0/0"/>

      <BindBuffer sampler="gShadowMap"       sourceRT="SHADOWBUF"       bufIndex="32" />
      <BindBuffer sampler="gCloudShadowMap"  sourceRT="CLOUDSHADOWS"    bufIndex="0" addressMode="wrap" />
      <BindBuffer sampler="gLightBins"       sourceRT="LIGHTS_BINS_DUMMY" bufIndex="0" />

      <BindBuffer sampler="gDepthBuffer"     sourceRT="DEPTH_LINEAR"    bufIndex="0" />

      <ColourMask channels="RGBA"/>

      <!--Transparent Objects--> 
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="add" depthTest="less" alphaToCoverage="false"/>
      <DoForwardLightLoop type="Mesh"     class="Additive"    context="LIT_FRWD_NS_NP" order="BACK_TO_FRONT" />
      <ColourMask channels="RGB"/>

      <!--Gun-->
      <DrawGeometry type="Mesh"         class="GunAdditive"    context="LIT_FRWD_NS_NP"             order="STATECHANGES" />

      <SetContext zwrite="false" colourWrite="true" cullMode="back" blendMode="Blend_PostMultAlpha" depthTest="less" alphaToCoverage="false"/>
      <ColourMask channels="RGBA"/>
      <DoForwardLightLoop type="Mesh"     class="Translucent" context="LIT_FRWD_NS_NP" order="BACK_TO_FRONT" />

      
      <!-- Solar system planet clouds, atmosphere & rings -->
      <SetContext zwrite="false" colourWrite="true" cullMode="front" blendMode="Blend_PostMultAlpha" depthTest="less" />
      <DoForwardLightLoop type="Mesh"         class="Atmosphere"              context="SCATTERING"     order="STATECHANGES" />

      <BindBuffer sampler="gBufferMap"       sourceRT="HDRBUF"          bufIndex="32" />
      <SetContext zwrite="false" colourWrite="true" cullMode="back" blendMode="Blend_PostMultAlpha" depthTest="less" />
      <DoForwardLightLoop type="Mesh"         class="Atmosphere"              context="CLOUDSHADOW"    order="STATECHANGES" />
      <DoForwardLightLoop type="Mesh"         class="Atmosphere"              context="CLOUD"          order="STATECHANGES" />
      <SetContext zwrite="false" colourWrite="true" cullMode="back"  blendMode="Blend_PostMultAlpha" depthTest="always"   />
      <DoForwardLightLoop type="Mesh"         class="RingsAbove"              context="RNGS_ABVE_RFLCTD"  order="STATECHANGES" />

      <ColourMask channels="RGB"/>

      <ClearTarget colBuf0="false" depthBuf="false" />
      <SetContext zwrite="false" colourWrite="true" cullMode="back" blendMode="Blend_PostMultAlpha" depthTest="lessEqual" />
      <DoForwardLightLoop type="Mesh"     class="Highlight" context="LIT_FORWARD" order="BACK_TO_FRONT" />
      <SetContext />


      <!--Trails--> 
      <!--<SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="Blend_PostMultAlpha" depthTest="less" alphaToCoverage="false"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always"/>
      <DoForwardLightLoop type="Trail" class="Translucent" context="LIGHTING" order="STATECHANGES" />

      <ColourMask channels="RGBA"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="add" depthTest="less" alphaToCoverage="false"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always"/>
      <DoForwardLightLoop type="Trail" class="Additive" context="LIGHTING_ADD" order="STATECHANGES" />
      <ColourMask channels="RGB"/>-->

      <!--Single Lines-->
      <SetContext zwrite="false" colourWrite="true" cullMode="none"  blendMode="Blend_PostMultAlpha" depthTest="less" alphaToCoverage="false"/>
      <DoForwardLightLoop type="SingleLine" class="Opaque" context="LIGHTING" order="STATECHANGES" />

      <ColourMask channels="RGBA"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="add" depthTest="less" alphaToCoverage="false"/>
      <DoForwardLightLoop type="SingleLine" class="Additive" context="LIGHTING" order="STATECHANGES" />
      <ColourMask channels="RGB"/>

       <!--Markers--> 
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="Blend_PostMultAlpha" depthTest="less" alphaToCoverage="false"/>
      <DoForwardLightLoop type="Mesh" class="Map" context="SCREEN_MAP" order="BACK_TO_FRONT" />

      <!--Glow Translucent--> 
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="Blend_PostMultAlpha" depthTest="less" alphaToCoverage="false"/>
      <ColourMask channels="RGBA"/>
      <DoForwardLightLoop type="Mesh"  class="GlowTranslucent" context="LIT_FRWD_NS_NP" order="BACK_TO_FRONT" />


      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="true" />

    </Stage>

    <Stage id="NewBloomBright" enabled="true">
      <If conditionType="platform" id="IOS|HHELD" negate="true" />
      <BeginTarget target="BLOOM_THRESHOLD" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />

      <ClearTarget colBuf0="true" col_R="0.0" col_G="0.0" col_B="0.0" col_A="0.7" />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_4B" />
      <RenderPass ColorAction0="DontCare/Store"/>
      <ColourMask channels="RGB"/>
      <BindBuffer sampler="gBufferMap"   sourceRT="HDRBUF"          bufIndex="0" />
      <BindBuffer sampler="gBuffer1Map"  sourceRT="BLOOM_THRESHOLD" bufIndex="0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuadMT material="materials/PostProcess.material.mbin" context="BRIGHTPASS_NEW" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_4A" />
      <RenderPass ColorAction0="DontCare/Store"/>
      <ColourMask channels="RGB"/>

      <BindBuffer sampler="gBufferMap"   sourceRT="BLOOM_BLURBUF_4B" bufIndex="0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuadMT material="materials/PostProcess.material.mbin" context="COPY" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />
      <EndIf />
    </Stage>

    <Stage id="NewBloomPre" enabled="true">
      <If conditionType="platform" id="IOS|HHELD" negate="true" />
      <!-- Horizontal blur at quarter-res; NewBloomPost completes the vertical pass into 4A -->
      <BeginTarget target="BLOOM_BLURBUF_4B" />
      <RenderPass ColorAction0="DontCare/Store"/>
      <ColourMask channels="RGB"/>

      <BindBuffer sampler="gBufferMap"  sourceRT="BLOOM_BLURBUF_4A" bufIndex="0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="0.0" b="1.0" c="5.0" />
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_9_HALF" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />
      <EndIf />
    </Stage>

    <Stage id="NewBloomPost" enabled="true">
      <If conditionType="platform" id="IOS|HHELD" negate="true" />
      <BeginTarget target="BLOOM_BLURBUF_4A" />
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_4B" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="0.0" c="5.0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_9_HALF" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_8B" />
      <ColourMask channels="RGB"/>
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap"  sourceRT="BLOOM_BLURBUF_4A" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="0.0" b="1.0" c="5.0" />
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_9" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_8A" />
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_8B" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="0.0" c="5.0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_9_HALF" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_16" />
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap"  sourceRT="BLOOM_BLURBUF_8A" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="0.0" c="3.0" d="1.0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_7_SQR" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_32" />
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_16" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="0.0" c="2.0" d="1.0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_5_SQR" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_64" />
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_32" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="0.0" c="2.0" d="1.0"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_5_SQR" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_32" />
      <RenderPass ColorAction0="Load/Store"/>

      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_64" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="1.0" c="1.5" d="4.0"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="add" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_5_SQR_ADD" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_16" />
      <RenderPass ColorAction0="Load/Store"/>

      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_32" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="1.0" c="1.5" d="2.0"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="add" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_5_SQR_ADD" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />
      <EndIf />
    </Stage>

    <Stage id="NewBloomResolve" enabled="true">
      <If conditionType="platform" id="IOS|HHELD" negate="true" />
      <!-- Resolve into 4B, then final blur ping-pong 4B -> 4A -> 4B (no dedicated FINALBUF) -->
      <BeginTarget target="BLOOM_BLURBUF_4B" />
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap"  sourceRT="BLOOM_BLURBUF_4A" bufIndex="0" />
      <BindBuffer sampler="gBuffer1Map" sourceRT="BLOOM_BLURBUF_8A" bufIndex="0" />
      <BindBuffer sampler="gBuffer2Map" sourceRT="BLOOM_BLURBUF_16" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="11.0" b="9.0" c="7.0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="BLOOM_RESOLVE" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_4A" />
      <RenderPass ColorAction0="DontCare/Store"/>
      
      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_4B" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="1.0" c="2.5" d="1.0"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_5_HALF" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_4B" />
      <RenderPass ColorAction0="DontCare/Store"/>

      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_4A" bufIndex="0" />
      <SetUniform material="materials/PostProcess.material.mbin" uniform="gBlurParamsVec4" a="1.0" b="1.0" c="2.5" d="1.0"/>
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="GUASS_5_HALF" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />
      <EndIf />
    </Stage>

    <!-- Enable this stage when you disable bloom stages, to clear the bloom buffers -->
    <Stage id="NoBloom" enabled="false">
      <BeginTarget target="BLOOM_BLURBUF_4A" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />
      <ClearTarget colBuf0="true"/>
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_4B" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />
      <ClearTarget colBuf0="true"/>
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_8A" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />
      <ClearTarget colBuf0="true"/>
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_8B" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />
      <ClearTarget colBuf0="true"/>
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_16" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />
      <ClearTarget colBuf0="true"/>
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_32" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />
      <ClearTarget colBuf0="true"/>
      <EndTarget flushCB="true" flushDB="false" />

      <BeginTarget target="BLOOM_BLURBUF_64" />
      <RenderPass ColorAction0="Clear/Store" ClearColor="0/0/0/0" />
      <ClearTarget colBuf0="true"/>
      <EndTarget flushCB="true" flushDB="false" />
    </Stage>

    <Stage id="ApplyBloom" enabled="true">
      <If conditionType="platform" id="IOS|HHELD" negate="true" />
      <BeginTarget target="HDRBUF" />
      <RenderPass ColorAction0="Load/Store" />
      <ColourMask channels="RGB"/>
      <BindBuffer sampler="gBufferMap" sourceRT="BLOOM_BLURBUF_4B" bufIndex="0" />
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="add" depthTest="always" alphaToCoverage="false"/>
      <DrawQuad material="materials/PostProcess.material.mbin" context="COPY" />
      <UnbindBuffers />
      <EndTarget flushCB="true" flushDB="false" />
      <EndIf />
    </Stage>

    <Stage id="Combine">
      <ColourMask channels="RGBA"/>
      <BeginTarget target=""/>
      <RenderPass ColorAction0="DontCare/Store" ClearColor="0/0/0/0" DepthAction="DontCare/DontCare" StencilAction="DontCare/DontCare"/>
        
      <ColourMask channels="RGBA"/>
        
      <SetContext zwrite="false" colourWrite="true" cullMode="none"  blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <BindBuffer sampler="gBufferMap" sourceRT="HDRBUF"  bufIndex="0" />
      <DrawQuad material="materials/PostProcess.material.mbin" context="GAMMACORRECT_UI" />
      <UnbindBuffers />

      <EndTarget flushCB="true" flushDB="false" />

    </Stage>


    <Stage id="Reset States">
      <SetContext zwrite="false" colourWrite="true" cullMode="none" blendMode="replace" depthTest="always" alphaToCoverage="false"/>
      <ColourMask channels="RGBA"/>
    </Stage>

  </CommandQueue>

</Pipeline>
